{
  "name": "feedback-toolbar",
  "version": "0.1.0",
  "description": "Framework-independent website feedback for humans and coding agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "feedback-toolbar": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/embed.d.ts",
      "import": "./dist/embed-module.js"
    }
  },
  "files": [
    "dist",
    "public",
    "assets/icon.svg",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node --import tsx scripts/build.ts",
    "build:vercel": "node --import tsx scripts/build-vercel.ts",
    "deploy:vercel": "node --import tsx scripts/deploy-vercel.ts",
    "dev": "node --import tsx scripts/dev.ts",
    "start": "node dist/server.js",
    "cli": "node --import tsx src/cli/main.ts",
    "mcp": "node --import tsx src/cli/mcp.ts",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip --no-progress",
    "test": "bun run build:dashboard && node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:pins": "playwright test --config=e2e/pins.config.ts",
    "worker:check": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply feedback-toolbar --remote",
    "deploy:worker": "wrangler deploy",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run test && bun run build && bun run test:e2e && bun run worker:check",
    "prepack": "bun run build",
    "build:dashboard": "react-router build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/api-key": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@fontsource/geist-mono": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@react-router/node": "8.5.1",
    "@tanstack/react-query": "^5.105.3",
    "better-auth": "1.7.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "emoji-regex": "10.6.0",
    "emojibase-data": "17.0.0",
    "frimousse": "0.4.0",
    "hono": "4.13.16",
    "lucide-react": "^1.66.0",
    "proper-lockfile": "4.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7",
    "isbot": "^5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/node": "4.3.4",
    "@tailwindcss/oxide": "4.3.4",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "wrangler": "4.156.2"
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/bentbrain/feedback-toolbar.git"
  },
  "overrides": {
    "better-call": "1.4.4",
    "body-parser": "2.4.0",
    "fast-uri": "3.1.9",
    "undici": "7.30.1",
    "qs": "6.16.1"
  }
}
