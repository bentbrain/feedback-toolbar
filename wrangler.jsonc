{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedback-toolbar-api",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": false }],
  "account_id": "86ff820ef99c8f2a035eb3ab03ce095a",
  "vars": {
    "FEEDBACK_URL": "https://feedback-toolbar-bentbrain.vercel.app",
    "DEMO_URL": "https://feedback-toolbar-api.socialqueue.workers.dev/example",
    "FEEDBACK_ALLOW_SIGNUP": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback-toolbar",
      "database_id": "3e5dc2f8-52db-4d1d-9517-87607761e101",
      "migrations_dir": "migrations",
    },
  ],
}
